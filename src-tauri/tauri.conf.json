{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VLT Music",
  "version": "0.1.3",
  "identifier": "com.ytmusicdt.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VLT Music",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 560,
        "backgroundColor": "#0b0a09",
        "theme": "Dark",
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https: http://localmedia.localhost localmedia:; img-src 'self' https: data: blob: http://localmedia.localhost localmedia:; media-src https: blob: http://localmedia.localhost localmedia:; frame-src http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEzNjkzRkVCOUVGOUEwMDAKUldRQW9QbWU2ejlwbzQ2eHIwMnVTa0FKd0pXa1ZJRTM4Tk95Vkl5bG1FRDZ2YzZCTXArd1A3bUEK",
      "endpoints": [
        "https://github.com/vltstudio/vltmusic/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
